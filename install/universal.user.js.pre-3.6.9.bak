if (typeof module !== 'undefined' && module.exports) module.exports = PenniContinuity;


    // Penni continuity is a separate interaction owner; it never submits chat text.
    var penniContinuity = PenniContinuity.create({
        platform: platform.id,
        get: function (key, fallback) { return GM_getValue(key, fallback); },
        set: function (key, value) { GM_setValue(key, value); },
        loadHandle: loadHandle,
        generating: modelIsGenerating
    });
    function boot() {
        log('Universal Braid Lens v' + VERSION + ' active for ' + platform.name);
        initVernierScrubber();
        injectPanel();
        window.setInterval(injectPanel, 1500);
        window.setTimeout(startObserver, 2500);
    }

    boot();
})();


